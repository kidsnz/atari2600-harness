# OS / editor
.DS_Store
.vscode/

# Japanese-language local sidecars (the author works in Japanese; the
# published repo is English-only). The English *.md are tracked; the
# Japanese originals are kept locally as *.ja.md and never published.
*.ja.md

# build output
/build/
/bin/
*.o

# Go
*.test
/bin/probe
/bin/harness
# stray harness MCP-server binary built to repo root (build to /bin instead)
/harness
# stray standalone cmd binaries built to repo root (build to /bin instead)
/rammap
/jingle
/dissect
/fieldtest
/calibrate
/scenario
/stellacheck
/ingest
/cpucheck
/cpucert
