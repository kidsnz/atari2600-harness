#!/usr/bin/env bash
# pre-push — mirror CI on WHAT IS BEING PUSHED, not on the working tree.
#
# WHY IT CHANGED, measured 2026-08-23. This hook used to run the gates over the working tree, and
# that is the same thing as the pushed commit only while ONE session is working. With two, another
# session's untracked file (internal/scenario/goldencover_test.go, four days old, belonging to
# neither of us) failed check_tests and blocked a clean push. The bypass — `--no-verify` — is the
# real damage: a gate that fires on somebody else's work teaches everyone to disable gates, and at
# three sessions the odds of someone having a dirty tree approach one.
#
# So the gates now run in a throwaway worktree checked out at the commit being pushed, which is
# exactly what CI will see.
#
# THE TRAP THIS WALKS PAST, and why the inventory check is not optional: the .bin fixtures are
# gitignored, so a fresh worktree has none, and the emulator tests answer a missing fixture with
# t.Skip — which is reported as PASS. The first version of this change was demonstrated "working"
# while testing nothing at all. Assembling the ROMs fixes that one case; comparing the fixture
# INVENTORY against the checkout catches the whole class, including the next fixture that is not
# a .bin. Measured: 137 t.Skip sites, only 80 of which say "unavailable", so grepping the skip
# message would have missed 41% of them.
#
# WHAT IT COSTS, measured 2026-08-23: 5m41s with `-p 1`; parallel was tried 2026-09-06 and reverted -- it times out internal/emu on CI's 4-core runner (see ci.yml). The
# version before this one claimed "~1 minute" while running the same suite, and an over-promising
# gate is what makes a surprise feel like an excuse to reach for --no-verify. If that is too slow
# to live with, the honest cut is to move the test sweep to CI and keep the cheap certain failures
# here (vet, the doc gates, the inventory) — not to keep the claim and drop the measurement.
#
# Enable once per clone:  git config core.hooksPath scripts/git-hooks
# Emergency bypass:        git push --no-verify
set -uo pipefail

REPO="$(git rev-parse --show-toplevel)"
SHA=""
REFS=0
TO_MAIN=0
LEAK_RANGES=""
TAG_OBJECTS=""
while read -r _lref lsha rref rsha; do
  REFS=$((REFS+1))
  case "$lsha" in ""|0000000000000000000000000000000000000000) continue ;; esac
  SHA="$lsha"
  # an annotated tag's message is written by a session and published with the tag (measured
  # 2026-10-17: it was never read); its text gets the same check as a commit message
  case "$rref" in refs/tags/*)
    [ "$(git -C "$REPO" cat-file -t "$lsha" 2>/dev/null)" = tag ] && TAG_OBJECTS="$TAG_OBJECTS $lsha" ;;
  esac
  # every ref of the push gets its own leak check (one push can carry several; measured 2026-10-17:
  # only the last ref's commits were read, so a leak on an earlier ref went out)
  case "$rsha" in ""|0000000000000000000000000000000000000000)
    if git -C "$REPO" rev-parse -q --verify origin/main >/dev/null; then
      LEAK_RANGES="$LEAK_RANGES origin/main..$lsha"; else LEAK_RANGES="$LEAK_RANGES $lsha"; fi ;;
  *) LEAK_RANGES="$LEAK_RANGES $rsha..$lsha" ;;
  esac
  # The REMOTE sha git hands us is the state being replaced. Comparing against it — rather than
  # against a local `origin/main`, which may already have been fetched forward — is what makes the
  # workflow guard below see the change the push actually carries.
  case "$rref" in refs/heads/main|refs/heads/master) TO_MAIN=1; BASE="$rsha" ;; esac
done
# A DELETION HAS NOTHING TO TEST. `git push --delete branch` sends an all-zero local sha, which the
# loop skips; SHA then stayed empty and the fallback below reached for HEAD — so deleting a branch
# spent 5 min 41 s building and testing a commit that was not being pushed, and could FAIL on a
# dirty HEAD and refuse a deletion that has no relationship to it. Measured 2026-08-23 by the other
# session. The fallback stays for the case it was written for: a hook run by hand or by a client
# that sends no refs at all, where HEAD is the only thing there is to check.
if [ -n "$SHA" ]; then
  :
elif [ "$REFS" -gt 0 ]; then
  echo "pre-push: nothing but deletions in this push — no commit to test, skipping the gate." >&2
  exit 0
else
  SHA="$(git rev-parse HEAD)"
fi

# ---------------------------------------------------------------------------------------------
# CI'S OWN CONFIGURATION CANNOT BE TESTED BY THIS HOOK. Everything below runs on THIS machine, so
# it can only catch what is machine-independent. A change to how CI invokes the tests is, by
# definition, not that.
#
# Measured 2026-09-06, which is why this block exists. `-p 1` was removed from ci.yml after three
# green parallel runs on an 8-core machine (265 s against 539 s). CI has four. Parallel packages
# share cores rather than each running faster, `internal/emu` lost its exclusive access, and the
# first CI run died on `panic: test timed out after 10m0s`. This hook passed it, because on eight
# cores it is green. The commit even carried the words "the ratio does not carry to CI's 4-core
# runner" — the caveat was known, written down, and pushed straight past.
#
# So: a commit that touches ci.yml does not go to main from here. Push it to a branch, read the
# run, then merge. That is the one step that was missing, and it is not something a human should
# have to remember while a green hook is telling them to go ahead.
BASE="${BASE:-}"
case "$BASE" in ""|0000000000000000000000000000000000000000) BASE="" ;; esac
if [ "$TO_MAIN" = "1" ] && [ -n "$BASE" ] \
   && ! git -C "$REPO" diff --quiet "$BASE..$SHA" -- .github/workflows/ 2>/dev/null; then
  cat >&2 <<'CIGUARD'

✗ pre-push BLOCKED: this push changes .github/workflows/ and targets main.

  Nothing on this machine can tell you whether CI will pass -- that is what CI is for, and a
  workflow change is exactly the case where local greenness proved nothing (2026-09-06: three
  green runs here, timeout on the first real one). Push a branch and read the run:

      git push origin HEAD:ci-check          # then: gh run list -R kidsnz/atari2600-harness -L 1
      # green? then merge it to main.

  Deliberate exception, with the run already read: git push --no-verify
CIGUARD
  exit 1
fi

# NOTHING PRIVATE LEAVES THIS MACHINE (2026-10-15). The pre-commit and commit-msg hooks check each
# commit as it is made; this checks every commit the push carries, lines AND messages, because a
# commit made with --no-verify, or before those hooks existed, reaches here unchecked. It runs
# first because it is cheap and a leak is the one failure a later fix cannot take back.
for TAG in $TAG_OBJECTS; do
  TAG_MSG="$(mktemp "${TMPDIR:-/tmp}/tagmsg.XXXXXX")"
  git -C "$REPO" cat-file -p "$TAG" | sed '1,/^$/d' > "$TAG_MSG"
  python3 "$REPO/scripts/check_leaks.py" --message "$TAG_MSG" || {
    rm -f "$TAG_MSG"
    echo ""
    echo "✗ pre-push BLOCKED: the message of tag ${TAG:0:8} names something private."
    exit 1
  }
  rm -f "$TAG_MSG"
done
[ -n "$LEAK_RANGES" ] || LEAK_RANGES="$SHA"
for LEAK_RANGE in $LEAK_RANGES; do
python3 "$REPO/scripts/check_leaks.py" --range "$LEAK_RANGE" || {
  echo ""
  echo "✗ pre-push BLOCKED: a private word or a machine path is in what this push carries."
  echo "  A commit already made has to be rewritten (git commit --amend, or git rebase) before pushing."
  exit 1
}
done

# A previous run killed outright (SIGKILL skips the trap) leaves its worktree registered; prune
# before adding, or `git worktree list` grows a tail of dead entries that nothing removes.
git -C "$REPO" worktree prune >/dev/null 2>&1
W="$(mktemp -d "${TMPDIR:-/tmp}/prepush.XXXXXX")"
cleanup() { git -C "$REPO" worktree remove --force "$W" >/dev/null 2>&1; rm -rf "$W"; }
trap cleanup EXIT

fail() {
  echo ""
  echo "✗ pre-push BLOCKED: '$1' failed on the commit being pushed — fix it (or: git push --no-verify)"
  exit 1
}

echo "pre-push: mirroring CI on ${SHA:0:8} (a throwaway worktree, not this working tree)…"
git -C "$REPO" worktree add --detach -q "$W" "$SHA" || fail "worktree add"
ln -s "$REPO/Gopher2600" "$W/Gopher2600" 2>/dev/null

# CI assembles these; without them every emulator test SKIPs and its package reports PASS.
( cd "$W" && for f in roms/litmus/*.asm roms/techniques/*.asm roms/exerciser/*.asm roms/carts/*.asm; do
    [ -e "$f" ] || continue
    dasm "$f" -f3 -o"${f%.asm}.bin" >/dev/null 2>&1
  done )

# A gate that silently tests nothing is worse than no gate, so prove the world is the same one.
missing="$(comm -13 <(cd "$W" && find roms -name '*.bin' | sort) <(cd "$REPO" && find roms -name '*.bin' | sort))"
if [ -n "$missing" ]; then
  echo ""
  echo "  fixtures present in the checkout but MISSING from the worktree:"
  echo "$missing" | head -10 | sed 's/^/    /'
  fail "fixture inventory (the gate would have tested an emptier world than CI)"
fi

cd "$W" || fail "cd worktree"
export GOWORK=off CGO_ENABLED=0
go vet ./...                              || fail "go vet"
go test -p 1 ./...                        || fail "go test -p 1"
python3 scripts/check_wiring.py           || fail "check_wiring"
python3 scripts/check_provenance.py       || fail "check_provenance"
python3 scripts/check_traps.py --selftest || fail "check_traps --selftest"
python3 scripts/check_traps.py            || fail "check_traps"
python3 scripts/check_tests.py --selftest || fail "check_tests --selftest"
python3 scripts/check_tests.py            || fail "check_tests"
python3 scripts/check_instruments.py --selftest || fail "check_instruments --selftest"
python3 scripts/check_instruments.py      || fail "check_instruments"
# check_memory reads ~/.claude/.../memory, which a CI checkout does not have (it skips there and
# proves nothing), so this hook is its only real home. It was wired to NOTHING from the day it was
# written until 2026-08-13 — see docs/gate-ledger.md.
python3 scripts/check_memory.py           || fail "check_memory"

echo "✓ pre-push: the pushed commit is green — pushing."
